# Copy to .env (git ignores it). Groq is the main provider; Workers AI is a second option for when Groq
# is down or over its daily limit. Both run gpt-oss-120b; Workers AI writes about 8x slower (DECISIONS §50).
# Which provider the command line and the live test use when --provider is not given: groq | workers_ai
LLM_PROVIDER=groq

# Groq (main): create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI (second option): in the dashboard, open Workers AI, choose "Use REST API",
# create a token from the "Workers AI" template, and copy the account id shown there.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
