# Copy to .env (git ignores it) and fill in one provider. Both run gpt-oss-120b.
# Which provider the command line and the live test use when --provider is not given: groq | workers_ai
LLM_PROVIDER=groq

# Groq: create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Cloudflare Workers AI: in the dashboard, open Workers AI, choose "Use REST API",
# create a token from the "Workers AI" template, and copy the account id shown there.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
